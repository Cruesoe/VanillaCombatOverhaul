<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>VanillaCombatOverhaul</RootNamespace>
    <AssemblyName>VanillaCombatOverhaul</AssemblyName>
  </PropertyGroup>

  <!-- 1.7's UnityStubs forwards Material to Waylith.dll, which Graphics.DrawMesh calls need to compile -->
  <ItemGroup Condition="'$(RimWorldGameVersion)' == '1.7'">
    <Reference Include="Waylith">
      <HintPath>$(RimWorldManaged)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
