<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- The parts check the setting at runtime, so toggling needs no restart. Conditional because a StatDef without parts has no list to add to. -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/StatDef[defName="AimingDelayFactor"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/StatDef[defName="AimingDelayFactor"]/parts</xpath>
      <value>
        <li Class="VanillaCombatOverhaul.StatPart_FireModeAimTime" />
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/StatDef[defName="AimingDelayFactor"]</xpath>
      <value>
        <parts>
          <li Class="VanillaCombatOverhaul.StatPart_FireModeAimTime" />
        </parts>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/StatDef[defName="RangedCooldownFactor"]/parts</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/StatDef[defName="RangedCooldownFactor"]/parts</xpath>
      <value>
        <li Class="VanillaCombatOverhaul.StatPart_FireModeCooldown" />
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/StatDef[defName="RangedCooldownFactor"]</xpath>
      <value>
        <parts>
          <li Class="VanillaCombatOverhaul.StatPart_FireModeCooldown" />
        </parts>
      </value>
    </nomatch>
  </Operation>
</Patch>
