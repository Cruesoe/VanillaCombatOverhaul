<?xml version="1.0" encoding="UTF-8"?>
<Patch>

  <!-- Adds directional groups to every BodyDef, modded races included (approach from Vanilla Combat Reloaded by Donald):
       parts labelled "left" only from the left, "right" only from the right, everything else from both and midline,
       the core part from every angle. Existing groups are kept. -->

  <Operation Class="VanillaCombatOverhaul.PatchOperationSettingGated">
    <setting>DirectionalDamage</setting>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- 1. Guarantee every part has a groups list to add to. -->
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/BodyDef//li[def and not(groups)]</xpath>
          <value>
            <groups />
          </value>
        </li>

        <!-- 2. Not left-labelled, so reachable from the right.
                translate() folds case, so "Left", "LEFT" and "left" all match. -->
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/BodyDef//li[def][not(customLabel) or not(contains(translate(customLabel,'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz'),'left'))]/groups</xpath>
          <value>
            <li>VCO_Right</li>
          </value>
        </li>

        <!-- 3. Not right-labelled, so reachable from the left. -->
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/BodyDef//li[def][not(customLabel) or not(contains(translate(customLabel,'ABCDEFGHIJKLMNOPQRSTUVWXYZ','abcdefghijklmnopqrstuvwxyz'),'right'))]/groups</xpath>
          <value>
            <li>VCO_Left</li>
          </value>
        </li>

        <!-- 4. Reachable from both sides means it sits on the midline. -->
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/BodyDef//groups[li[.='VCO_Left'] and li[.='VCO_Right']]</xpath>
          <value>
            <li>VCO_Center</li>
          </value>
        </li>

        <!-- 5. The core part is not an <li>, so it is missed above; it gets every side. -->
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/BodyDef/corePart[not(groups)]</xpath>
          <value>
            <groups />
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <success>Always</success>
          <xpath>Defs/BodyDef/corePart/groups</xpath>
          <value>
            <li>VCO_Left</li>
            <li>VCO_Right</li>
            <li>VCO_Center</li>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
